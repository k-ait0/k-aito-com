# A05 isolated non-standardized self-reflection beta.
# This file only affects /projects/kidp/life-design-lab/a05/.
# Explicit ES module MIME; browsers reject octet-stream for module scripts.
AddType text/javascript .mjs

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Cache-Control "no-store"
  Header always set Content-Security-Policy "default-src 'none'; base-uri 'none'; object-src 'none'; form-action 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; media-src 'none'; worker-src 'none'"
</IfModule>

  "operational_definitions": {
    "broad_context": "Higher-level observational domain such as daily systems or joint decisions; may contain several genuinely distinct semantic question families, but re-labeling does not establish distinctness.",
    "semantic_family": "Questions using substantively the same judgment process and contrast/poles, even if object, location, or participants change.",
    "exact_duplicate": "Two questions with equivalent decision, equivalent constraints and equivalent response reasoning, including paraphrases.",
    "allowable_second_item": "Distinct enough that a respondent can give different answers for a legitimate value-relevant reason rather than merely differing money, skills, ownership, relationships, fatigue, or duties.",
    "not_counted_as_evidence": "Different examples, new wording, same polarity, or new proposed IDs without new information do not establish different families."
  },
  "hierarchy_rule": "D156 3/3/4/4 broad contexts are NOT a substitute for >=6 distinct semantic families per A-D axis. Distinct subfamilies require editorial and respondent-review evidence.",

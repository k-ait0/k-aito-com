  "method": "Manual content-meaning audit of each of 40 followups against all 30 v2 stems (5 axes), plus within-followup overlaps. Classification is a documented editorial judgment, not a measured semantic similarity or item-information estimate.",
  "relationDefinition": {
    "DIRECT": "Substantially repeats the same decision or contrast, even with mild assumptions or Y/N recoding.",
    "CONDITIONAL": "Shares the base construct but manipulates a constraint, situational setting or decision stage; incremental validity unproven.",
    "NEW_CONTEXT": "Adds a new decision setting not directly present in original 30; usefulness and wording unproven.",
    "PROBE": "Diagnoses interpretation, context dependence or confounds rather than increasing a classification score."
  },
  "dispositionDefinition": {
    "DROP": "Remove from adaptive follow-up candidate set; possible future replacement of a base item is a separate editorial decision.",
    "REWRITE": "Rewrite to isolate the additional condition, balance both options and test incremental information.",
    "HOLD": "Insufficient distinct information or high confound risk; keep only as unresolved research idea.",
    "REVISE_NEW": "New context might add information, but the currently unbalanced wording requires revision.",
    "PROBE_ONLY": "May be asked as optional comprehension or context check, never numerically scored for the type."
  },

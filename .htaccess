# XServer Static configuration
RewriteEngine On

# Backward-compatible image routes for cached HTML/CSS.
RewriteRule ^assets/study\.(?:webp|png)$ /study.svg [R=302,L,NE]
RewriteRule ^assets/editorial\.(?:webp|png)$ /editorial-legacy.svg [R=302,L,NE]
RewriteRule ^assets/kaito-logo-transparent\.(?:webp|png)$ /kaito-logo-legacy.svg [R=302,L,NE]

# Social thumbnail compatibility: serve a raster image even when cached HTML requests the SVG URL.
RewriteRule ^og-image\.svg$ /og-image.png [R=302,L,NE]
